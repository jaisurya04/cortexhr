# Copy to .env (never commit .env). Every setting is optional; defaults are for local development.
CORTEXHR_ENV=development              # development | production
CORTEXHR_LOG_LEVEL=INFO
CORTEXHR_API_URL=http://127.0.0.1:8000   # used by the console and smoke test
CORTEXHR_API_KEY=                     # optional shared API key; set the same value for API and console
CORTEXHR_AUTH_SECRET=                 # REQUIRED in production: long random signing secret (never commit)
CORTEXHR_AUTH_USERS=                  # JSON object of users with PBKDF2 hashes; generate with python phase4/scripts/create_user.py
CORTEXHR_ALLOWED_ORIGINS=*            # comma-separated list in production
CORTEXHR_VAULT_DIR=                   # local folder with the restricted CX-12 / CX-15 files (enables the gender pay-gap check). Never committed.
CORTEXHR_MOCK_SERVICE_URL=http://127.0.0.1:9000   # Phase 2 mock HR service (leave / payslip chatbot intents)
CORTEXHR_SHOW_WELCOME=true
